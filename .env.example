# Render provides DATABASE_URL automatically when you attach a PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Strong random value used to sign admin sessions.
JWT_SECRET=change-this-to-a-long-random-string

# Password used for edit/link/deactivate/generate operations.
ADMIN_PASSWORD=change-this-password

# Render sets PORT automatically. Local development can use 3000.
PORT=3000

# Optional: set to true if your database requires SSL. Render Postgres usually works with sslmode=require in DATABASE_URL.
DB_SSL=false
